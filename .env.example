# Semua nilai di bawah SAMA dengan project cishu-admin (database & layanan dipakai bersama).
# Cara termudah: `vercel env pull .env.local` di project Vercel `cishu`. JANGAN commit .env.local.

# Postgres (Supabase pooler, port 6543) — database bersama dengan cishu-admin. Storefront hanya
# membaca katalog/pengaturan dan menulis pesanan, pelanggan, ulasan, dan analytics.
DATABASE_URL=

# Menandatangani cookie sesi pelanggan (HMAC). WAJIB, minimal 16 karakter acak. Tanpa ini semua
# login/sesi pelanggan ditolak (fail-closed). Berbeda dari JWT_SECRET milik cishu-admin.
SESSION_SECRET=

# Bearer secret untuk POST /api/revalidate (dipanggil cishu-admin setelah edit produk/kategori/
# pengaturan). Harus sama dengan REVALIDATE_SECRET di cishu-admin.
REVALIDATE_SECRET=

# Bearer secret untuk GET /api/cron/daily-report (Vercel Cron mengirimnya otomatis). Wajib.
CRON_SECRET=

# Firebase Admin (service account JSON satu baris) — dipakai untuk notifikasi ke admin (koleksi
# `notifications`/`fcmTokens`) dan verifikasi token "Masuk dengan Google".
FIREBASE_SERVICE_ACCOUNT=

# Firebase Web App (client-safe) — tombol "Masuk dengan Google" di /login & /register.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Cloudinary — upload bukti pembayaran (POST /api/upload-payment-proof). Akun sama dengan cishu-admin.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# CallMeBot WhatsApp — rekap harian (/api/cron/daily-report) dan notifikasi pengunjung (/api/track).
CALLMEBOT_API_KEY=
NOTIFY_PHONE=

# Opsional: origin yang diizinkan CORS untuk /api/invoice dan /api/revalidate (src/proxy.ts).
ADMIN_ORIGIN=

# Opsional: URL website kalau "URL Website" di admin Settings belum diisi.
# Di Vercel otomatis memakai domain produksi (VERCEL_PROJECT_PRODUCTION_URL).
NEXT_PUBLIC_SITE_URL=

# Statistik beranda (terjual/rating) hanya menghitung data sejak tanggal ini (ISO). Default: 2026-11-20T00:00:00+07:00
STATS_SINCE=
